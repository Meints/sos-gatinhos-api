generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id               String          @id 
  name             String
  email            String          @unique
  emailVerified    Boolean         @default(false)
  image            String?
  role             UserRole        @default(ADOPTER)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  
  sessions         Session[]
  accounts         Account[]
  
  adopterProfile   AdopterProfile?
  cats             Cat[]
  adoptions        Adoption[]
  
  routeAssignments VolunteerAssignment[]
  routeRuns        RouteRun[]
  volunteerApplications VolunteerApplication[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model AdopterProfile {
  userId    String    @id
  phone     String?
  cpf       String?
  birthDate DateTime?
  
  cep            String?
  street         String?
  number         String?
  complement     String?
  district       String?
  city           String?
  state          String?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("adopter_profile")
}

model Cat {
  id          String     @id @default(uuid())
  name        String
  color       Color
  gender      Gender
  status      CatStatus  @default(AVAILABLE)
  description String?
  photos      String[]   @default([])
  birthDate   DateTime?
  isNeutered  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  
  adoptions   Adoption[]
  userId      String?
  user        User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("cat")
}

model Adoption {
  id           String         @id @default(uuid())
  userId       String
  catId        String
  adoptionDate DateTime       @default(now())
  status       AdoptionStatus @default(PENDING)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cat          Cat            @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([catId])
  @@map("adoption")
}

enum UserRole {
  ADMIN
  COLLABORATOR
  ADOPTER
  VOLUNTEER
}

model VolunteerApplication {
  id              String            @id @default(uuid())
  userId          String
  status          ApplicationStatus @default(PENDING)
  motivation      String
  availability    String
  linkedinProfile String?
  phone           String
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("volunteer_application")
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Color {
  BLACK              // Preto
  WHITE              // Branco
  GRAY               // Cinza
  ORANGE             // Laranja
  CREAM              // Creme
  BROWN              // Marrom
  CALICO             // Tricolor (branco + preto + laranja)
  TORTOISESHELL      // Escama de tartaruga (preto + laranja mesclado)
  TABBY_BROWN        // Tigrado marrom
  TABBY_GRAY         // Tigrado cinza
  TABBY_ORANGE       // Tigrado laranja
  BICOLOR_BLACK      // Preto e branco
  BICOLOR_GRAY       // Cinza e branco
  BICOLOR_ORANGE     // Laranja e branco
  POINT              // Siamês (cor clara no corpo, extremidades escuras)
  VAN                // Quase todo branco com algumas marcas
  SHADED             // Sombreado (pelagem gradiente)
  SMOKE              // Fumaça (pelagem escura com raiz clara)
  MINK               // Mink (pelagem de contraste suave)
}

enum Gender {
  MALE
  FEMALE
}

enum CatStatus {
  AVAILABLE
  ADOPTED
}

enum AdoptionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

model Route {
  id          String   @id @default(uuid())
  title       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  points      RoutePoint[]
  assignments VolunteerAssignment[]
  runs        RouteRun[]

  @@map("route")
}

model RoutePoint {
  id           String   @id @default(uuid())
  routeId      String
  sequence     Int
  title        String
  description  String?  // Instructions for this point
  latitude     Float?   // Optional: for map visualization
  longitude    Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  route        Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  checkIns     CheckIn[]

  @@map("route_point")
}

model VolunteerAssignment {
  id          String   @id @default(uuid())
  userId      String
  routeId     String
  assignedAt  DateTime @default(now())
  active      Boolean  @default(true) // If they are currently assigned to this route

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  route       Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([routeId])
  @@unique([userId, routeId]) // User can only be assigned once effectively to a route (or we just use active flag)
  @@map("volunteer_assignment")
}

model RouteRun {
  id          String        @id @default(uuid())
  routeId     String
  userId      String        // Volunteer who ran it
  startTime   DateTime      @default(now())
  endTime     DateTime?
  status      RouteRunStatus @default(IN_PROGRESS)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  route       Route         @relation(fields: [routeId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkIns    CheckIn[]

  @@index([userId])
  @@index([routeId])
  @@map("route_run")
}

model CheckIn {
  id           String   @id @default(uuid())
  routeRunId   String
  routePointId String
  checkedAt    DateTime @default(now())
  photoUrl     String?
  notes        String?
  
  routeRun     RouteRun   @relation(fields: [routeRunId], references: [id], onDelete: Cascade)
  routePoint   RoutePoint @relation(fields: [routePointId], references: [id], onDelete: Cascade)

  @@index([routeRunId])
  @@index([routePointId])
  @@map("check_in")
}

enum RouteRunStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}
